rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll(['productId', 'createdAt'])
        && request.resource.data.keys().hasOnly(['productId', 'createdAt'])
        && request.resource.data.productId in [
          'judydoll-kem-lot',
          'judydoll-ma-hong',
          'son-3ce-water-tint',
          'phan-carslan'
        ]
        && request.resource.data.createdAt == request.time;
      // Khách không được đọc đơn; chủ trang xem đơn trong Firebase Console.
      allow read, update, delete: if false;
    }
  }
}
